# Clave usada para firmar los tokens JWT. En producción debe ser un secreto largo y aleatorio.
JWT_SECRET_KEY=cambia-esta-clave-en-produccion-por-una-aleatoria-larga
JWT_EXPIRE_MINUTES=30

# Credenciales de los clientes OAuth 2.0 autorizados (client_credentials).
# Formato: client_id:client_secret:scopes_separados_por_coma
OAUTH_CLIENTS=ebs-facatativa-01:secreto-demo-123:rutas:generar,auditoria:leer

# Base de datos de auditoría (SQLite por defecto; cambiar a PostgreSQL es solo cambiar esta URL)
DATABASE_URL=sqlite:///./auditoria.db
